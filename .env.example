# Copy this file to `.env` (never committed) or set these as environment variables.
# On Colab, store them as notebook secrets instead.

# Hugging Face access token: needed for gated models (e.g. Stable Audio Open) and uploads.
# huggingface_hub reads HF_TOKEN automatically.
HF_TOKEN=

# Where datasets live. Leave empty to use ./data. On Colab, point it at Google Drive,
# e.g. /content/drive/MyDrive/verasonus/data
VERASONUS_DATA_ROOT=
