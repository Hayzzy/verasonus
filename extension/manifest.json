{
  "manifest_version": 3,
  "name": "VeraSonus (Phase 4 skeleton)",
  "version": "0.0.1",
  "description": "Phase 4: check whether the music playing in the current tab is AI-generated.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VeraSonus"
  },
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "permissions": ["tabCapture", "offscreen"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
